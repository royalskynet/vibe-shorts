  },
  {
   "t0": 24.68,
   "t1": 25.7,
   "text": "遊戲結束"
  },
  {
   "t0": 25.7,
   "t1": 27.54,
   "text": "第一關的123 木頭人"
  },
  {
   "t0": 27.54,
   "t1": 30.18,
   "text": "John Wick很快解決了所有的工作人員"
  },
  {
   "t0": 30.18,
   "t1": 31.84,
   "text": "包含的是木偶"
  },
  {
   "t0": 31.84,
   "t1": 33.04,
   "text": "在碰堂的那一關"
  },
  {
   "t0": 33.04,
   "t1": 34.86,
